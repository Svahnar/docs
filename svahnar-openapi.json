            "type": "string",
            "title": "Name",
            "description": "Name of the agent."
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Description of the agent."
          },
          "agent_icon": {
            "anyOf": [
              {
                "type": "string"
              },
