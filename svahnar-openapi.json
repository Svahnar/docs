{
  "openapi": "3.1.0",
  "info": {
    "title": "SVAHNAR API",
    "description": "Welcome to the official SVAHNAR API Reference!\n\nHere you can find all the endpoints you need to interact with SVAHNAR programmatically.\n\n### Additional Resources\n- [Main Website](https://www.svahnar.com)\n- [Support & Contact](https://www.svahnar.com/contact)\n- [Developer Guide](/docs/GetStarted/Overview)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.svahnar.com"
    }
  ],
  "paths": {
    "/v1/agents/run": {
      "post": {
        "tags": [
          "Agent Operations"
        ],
        "summary": "Run a deployed Agent",
        "description": "Execute an agent by sending the provided message to the agent service. Returns a detailed response containing the conversation messages, logs, and metadata.",
        "operationId": "run_agent_v1_agents_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/agents/test": {
      "post": {
        "tags": [
          "Agent Operations"
        ],
        "summary": "Test an Agent with YAML configuration",
        "description": "Test an agent by providing a YAML configuration (as a file or string) along with a message. The agent processes the message and returns a response without creating a persistent agent.",
        "operationId": "test_agent_v1_agents_test_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_test_agent_v1_agents_test_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/agents/validate": {
      "post": {
        "tags": [
          "Agent Operations"
        ],
        "summary": "Validate Agent YAML configuration",
        "description": "Validates the agent network configuration provided as a YAML file or string. Only files with a .yaml or .yml extension are accepted.",
