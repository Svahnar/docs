                "type": "null"
              }
            ],
            "title": "Agent Icon",
            "description": "Presigned S3 URL of the agent icon."
          },
          "is_creator": {
            "type": "boolean",
            "title": "Is Creator",
            "description": "Whether the requesting user is the creator of this agent."
          },
          "hosted_to": {
            "type": "string",
            "title": "Hosted To",
            "description": "Deployment target: 'AgentStore' or 'Organization'."
          },
          "uploaded_by": {
            "$ref": "#/components/schemas/UploadedByInfo",
            "description": "Information about the agent creator."
          }
        },
        "type": "object",
        "required": [
          "agent_id",
          "name",
          "description",
          "is_creator",
          "hosted_to",
          "uploaded_by"
        ],
        "title": "AgentDetailResponse",
        "description": "Single agent detail response with tracing metadata."
