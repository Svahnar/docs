                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v1/agents/create": {
      "post": {
        "tags": [
          "Agent Management"
        ],
        "summary": "Create a new Agent",
        "description": "Upload a YAML configuration file to create and deploy a new agent. Optionally provide an agent icon (required for AgentStore deployments).",
        "operationId": "create_agent_v1_agents_create_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
