      "put": {
        "tags": [
          "Agent Management"
        ],
        "summary": "Update Agent",
        "description": "Update an agent's name, description, deployment target, icon, generated questions, or reconfigure its YAML. Only the creator of the agent can perform this operation.",
        "operationId": "update_agent_v1_agents_update_put",
