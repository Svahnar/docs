          }
        },
        "type": "object",
        "title": "AdditionalMetadata"
      },
      "AgentDetailResponse": {
        "properties": {
          "agent_id": {
            "type": "string",
            "title": "Agent Id",
            "description": "Unique identifier of the agent."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Name of the agent."
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Description of the agent."
          },
          "agent_icon": {
            "anyOf": [
              {
                "type": "string"
              },
